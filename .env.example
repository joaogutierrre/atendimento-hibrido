# ── Docker Compose (raiz) ────────────────────────────────────────────
POSTGRES_DB=platform
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432

REDIS_PORT=6379

GATEWAY_PORT=3000
AGENT_PORT=8000

# ── service-gateway (copiar para service-gateway/.env) ───────────────
# DATABASE_URL=postgresql://user:pass@postgres:5432/platform
# REDIS_URL=redis://redis:6379
# JWT_SECRET=change-me-in-prod
# JWT_EXPIRES_IN=7d
# TELEGRAM_WEBHOOK_SECRET=change-me
# META_API_TOKEN=               # V2 (WhatsApp)
# META_VERIFY_TOKEN=            # V2 (WhatsApp)
# PORT=3000

# ── service-agent (copiar para service-agent/.env) ───────────────────
# DATABASE_URL=postgresql://user:pass@postgres:5432/platform
# REDIS_URL=redis://redis:6379
# ANTHROPIC_API_KEY=sk-ant-...
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PORT=8000
